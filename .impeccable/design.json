      "name": "Save reading",
      "kind": "button",
      "refersTo": "save-reading",
      "description": "The calibration submit control; states mirror the shipped form.",
      "html": "<button class=\"ds-save\" type=\"button\">Save reading</button>",
      "css": ".ds-save{font-family:var(--primary-font-family,Manrope,system-ui,sans-serif);color:var(--primary-text-color,#0d2233);font-size:14px;min-height:44px;padding:10px 20px;border:1px solid var(--primary-color,#2bb3d6);border-radius:6px;background:color-mix(in srgb,var(--primary-color,#2bb3d6) 18%,var(--ha-card-background,var(--card-background-color,#fff)));color:var(--primary-text-color,#171717);cursor:pointer;}.ds-save:hover{background:color-mix(in srgb,var(--primary-color,#2bb3d6) 26%,var(--ha-card-background,var(--card-background-color,#fff)));}.ds-save:active{background:color-mix(in srgb,var(--primary-color,#2bb3d6) 34%,var(--ha-card-background,var(--card-background-color,#fff)));}.ds-save:focus-visible{outline:2px solid var(--primary-color,#2bb3d6);outline-offset:3px;}.ds-save:disabled,.ds-save[aria-disabled=true]{opacity:.6;cursor:default;}"
    },
    {
      "name": "Meter reading field",
      "kind": "input",
      "refersTo": "reading-input",
      "description": "Permanent label, decimal entry and invalid-border support.",
      "html": "<div class=\"ds-field\"><label for=\"ds-reading\">Meter reading</label><input id=\"ds-reading\" type=\"text\" inputmode=\"decimal\" required aria-invalid=\"false\" value=\"1597.765\"></div>",
      "css": ".ds-field{font-family:var(--primary-font-family,Manrope,system-ui,sans-serif);color:var(--primary-text-color,#0d2233);font-size:14px;}.ds-field label{display:block;margin-bottom:8px;}.ds-field input{width:100%;min-width:0;min-height:44px;padding:10px 8px;border:1px solid var(--secondary-text-color,#5a6f7e);border-radius:6px;background:var(--ha-card-background,var(--card-background-color,#fff));color:var(--primary-text-color,#171717);font:inherit;caret-color:var(--primary-color,#2bb3d6);}.ds-field input:focus-visible{outline:2px solid var(--primary-color,#2bb3d6);outline-offset:3px;}.ds-field input[aria-invalid=true]{border-color:var(--error-color,#b3261e);}"
    },
    {
      "name": "Dial unit selector",
      "kind": "input",
      "refersTo": "unit-selector",
      "description": "Native radios with contiguous surfaces and selected accent underline.",
      "html": "<fieldset class=\"ds-unit-field\"><legend>Dial unit</legend><div class=\"ds-units\"><label><input type=\"radio\" name=\"ds-unit\" value=\"m³\" checked><span>m³</span></label><label><input type=\"radio\" name=\"ds-unit\" value=\"kL\"><span>kL</span></label><label><input type=\"radio\" name=\"ds-unit\" value=\"L\"><span>L</span></label></div></fieldset>",
      "css": ".ds-unit-field{font-family:var(--primary-font-family,Manrope,system-ui,sans-serif);color:var(--primary-text-color,#0d2233);font-size:14px;border:0;padding:0;margin:0;min-width:0;}.ds-unit-field legend{padding:0;margin-bottom:8px;}.ds-units{display:flex;width:100%;max-width:320px;}.ds-units label{position:relative;flex:1;cursor:pointer;}.ds-units input{position:absolute;width:1px;height:1px;opacity:0;}.ds-units span{display:flex;align-items:center;justify-content:center;min-height:44px;border:1px solid var(--divider-color,#ddd);background:var(--ha-card-background,var(--card-background-color,#fff));}.ds-units label+label span{border-inline-start:0;}.ds-units label:first-child span{border-radius:6px 0 0 6px;}.ds-units label:last-child span{border-radius:0 6px 6px 0;}.ds-units input:checked+span{color:var(--primary-text-color,#171717);font-weight:600;background:color-mix(in srgb,var(--primary-color,#2bb3d6) 15%,var(--ha-card-background,var(--card-background-color,#fff)));box-shadow:inset 0 -3px var(--primary-color,#2bb3d6);}.ds-units label:hover span{background:color-mix(in srgb,var(--primary-color,#2bb3d6) 10%,var(--ha-card-background,var(--card-background-color,#fff)));}.ds-units input:focus-visible+span{outline:2px solid var(--primary-color,#2bb3d6);outline-offset:3px;}"
    },
